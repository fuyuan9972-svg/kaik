{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Paper Rewriter",
  "version": "0.1.1",
  "identifier": "com.kaikai.ai-paper-rewriter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Paper Rewriter",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/apr-icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
